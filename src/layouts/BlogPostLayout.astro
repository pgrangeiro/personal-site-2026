---
import type { CollectionEntry } from 'astro:content';
import ArtifactTag from '../components/ArtifactTag.astro';
import CategoryLink from '../components/CategoryLink.astro';
import PostCard from '../components/PostCard.astro';
import BaseLayout from './BaseLayout.astro';
import { formatPublicationDate, getBlogPosts, toBlogSummary } from '../lib/blog';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { data } = post;
const tldrSummary = data.tldr.replace(/^TL;DR:\s*/i, '');
const posts = await getBlogPosts();
const relatedPosts = [
  ...posts.filter(
    (candidate) =>
      candidate.id !== post.id && candidate.data.category.id === data.category.id,
  ),
  ...posts.filter(
    (candidate) =>
      candidate.id !== post.id && candidate.data.category.id !== data.category.id,
  ),
].slice(0, 3);
---

<BaseLayout
  title={data.title}
  description={data.description}
  socialDescription={tldrSummary}
  ogType="article"
  pagefindMeta={{
    summary: data.description,
    tldr: tldrSummary,
    type: data.type,
    category: data.category.id,
    categoryLabel: data.category.label,
    date: data.pubDate.toISOString().slice(0, 10),
    readTime: data.readTime,
    artifacts: JSON.stringify(data.artifacts),
  }}
>
  <article class="space-y-8" data-pagefind-body>
    <a class="inline-flex items-center gap-2 font-mono text-xs text-muted transition-colors hover:text-terracotta" href="/work">
      <span aria-hidden="true">←</span>
      Back to Work & Notes
    </a>

    <header class="space-y-5 border-b border-hairline pb-8">
      <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-muted">
        <CategoryLink category={data.category} type={data.type} />
        <span aria-hidden="true">·</span>
        <time datetime={data.pubDate.toISOString()}>{formatPublicationDate(data.pubDate)}</time>
        <span aria-hidden="true">·</span>
        <span>{data.readTime}</span>
      </div>

      <h1 class="font-editorial text-3xl font-bold leading-tight text-ink sm:text-4xl lg:text-5xl">
        {data.title}
      </h1>

      <div class="space-y-1 rounded-xl border-l-4 border-terracotta bg-sand p-5 text-sm font-medium text-ink sm:text-base">
        <span class="block font-mono text-xs font-bold uppercase tracking-wider text-terracotta">
          Executive TL;DR
        </span>
        <p>{tldrSummary}</p>
      </div>

      <div class="flex flex-wrap items-center gap-2 pt-1">
        {data.artifacts.map((artifact) => <ArtifactTag artifact={artifact} />)}
      </div>
    </header>

    <div class="article-body">
      <slot />
    </div>

    {relatedPosts.length > 0 && (
      <section
        aria-labelledby="related-reading-heading"
        class="space-y-4 border-t border-hairline pt-8"
        data-pagefind-ignore="all"
      >
        <h2 class="font-editorial text-2xl font-bold text-ink" id="related-reading-heading">
          Keep reading
        </h2>
        <div class="divide-y divide-hairline border-y border-hairline">
          {relatedPosts.map((relatedPost) => <PostCard post={toBlogSummary(relatedPost)} />)}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<script>
  import { addCodeCopyButtons } from '../lib/codeBlockCopy';

  const articleBody = document.querySelector('.article-body');
  if (articleBody) addCodeCopyButtons(articleBody);
</script>
