---
import type { BlogSummary } from '../schemas/blog';
import ArtifactTag from './ArtifactTag.astro';
import CategoryLink from './CategoryLink.astro';

interface Props {
  post: BlogSummary;
}

const { post } = Astro.props;
---

<article class="group space-y-2 px-3 py-6 transition-colors hover:bg-sand/40">
  <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-xs">
    <div class="flex items-center gap-2">
      <CategoryLink category={post.typeCategory} type={post.type} />
      <span class="text-muted">{post.date}</span>
    </div>
    <span class="text-muted">{post.readTime}</span>
  </div>
  <h3 class="font-editorial text-xl font-bold text-ink transition-colors group-hover:text-terracotta">
    <a href={`/work/${post.slug}`}>{post.title}</a>
  </h3>
  <p class="text-sm font-medium text-muted">{post.tldr}</p>
  <div class="flex flex-wrap items-center justify-between gap-3 pt-1">
    <div class="flex flex-wrap gap-2">
      {post.artifacts.map((artifact) => <ArtifactTag artifact={artifact} compact />)}
    </div>
    <a
      aria-label={`Read ${post.title}`}
      class="inline-flex shrink-0 items-center gap-1 font-mono text-xs font-semibold text-terracotta transition-colors hover:underline focus-visible:underline"
      href={`/work/${post.slug}/`}
    >
      Read article <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
