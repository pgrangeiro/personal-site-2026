---
import type { BlogCategory, BlogSummary } from "../schemas/blog";
import Pagination from "./Pagination.astro";
import PostCard from "./PostCard.astro";

interface Props {
  posts: BlogSummary[];
  categories: BlogCategory[];
  page: number;
  pageCount: number;
  category?: BlogCategory;
}

const { posts, page, pageCount, category } = Astro.props;
const { categories } = Astro.props;
const basePath = category ? `/work/category/${category.id}` : "/work";
const title = category ? category.label : "Work, Playbooks & Notes";
---

<div
  class="space-y-8"
  data-pagefind-ignore="all"
  data-work-archive
  data-default-category={category?.id ?? ""}
  data-default-page={page}
>
  <header class="space-y-3 border-b border-hairline pb-6">
    <span class="font-mono text-xs font-semibold uppercase tracking-wider text-terracotta">
      ENGINEERING NOTEBOOK
    </span>
    <h1 class="font-editorial text-3xl font-bold text-ink sm:text-4xl">
      {title}
    </h1>
    <p class="max-w-2xl text-base text-muted">
      A consolidated index pairing career playbooks with hands-on prototypes,
      code harnesses, and architectural field notes.
    </p>
  </header>

  <div class="space-y-6">
    <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
      <nav
        aria-label="Filter work by category"
        class="flex w-full min-w-0 flex-wrap items-center gap-2 sm:w-auto sm:flex-nowrap"
      >
        {[
          { id: "", label: "All" },
          ...categories.map(({ id, label }) => ({ id, label })),
        ].map((filter) => (
          <a
            aria-current={
              (category?.id ?? "") === filter.id ? "page" : undefined
            }
            class:list={[
              "whitespace-nowrap rounded-full border px-3.5 py-1.5 font-mono text-xs transition-colors",
              (category?.id ?? "") === filter.id
                ? "border-terracotta bg-terracotta font-bold text-white"
                : "border-hairline bg-sand text-muted hover:border-terracotta hover:text-ink",
            ]}
            data-archive-filter={filter.id}
            href={filter.id ? `/work/category/${filter.id}/` : "/work/"}
          >
            {filter.label}
          </a>
        ))}
      </nav>

      <div class="w-full sm:w-64">
        <label class="sr-only" for="work-archive-search">
          Search titles, summaries, and tags
        </label>
        <input
          class="w-full rounded-lg border border-hairline bg-paper px-3 py-2 font-mono text-xs text-ink placeholder:text-muted focus:border-terracotta focus:outline-none focus:ring-2 focus:ring-terracotta/20"
          data-archive-search
          id="work-archive-search"
          placeholder="Search posts"
          type="search"
        />
      </div>
    </div>
    <p aria-live="polite" class="sr-only" data-archive-status role="status"></p>

    <section
      data-archive-results
      aria-label={category ? `${title} posts` : "All posts"}
      class="divide-y divide-hairline border-y border-hairline"
    >
      {posts.length > 0 ? (
        posts.map((post) => <PostCard post={post} />)
      ) : (
        <p class="py-12 text-center font-mono text-sm text-muted">
          No notebook entries in this category yet.
        </p>
      )}
    </section>

    <div class="space-y-3 py-12 text-center" data-archive-empty hidden>
      <p class="font-mono text-sm text-muted">No posts match your filters.</p>
      <button
        class="rounded-lg border border-hairline bg-sand px-3 py-2 font-mono text-xs text-ink transition-colors hover:border-terracotta hover:text-terracotta"
        data-archive-reset
        type="button"
      >
        Reset filters
      </button>
    </div>
    <p
      aria-live="assertive"
      class="py-4 text-center font-mono text-xs text-terracotta"
      data-archive-error
      hidden
      role="alert"
    ></p>
    <nav
      aria-label="Filtered results pagination"
      class="items-center justify-between border-t border-hairline pt-5 font-mono text-xs"
      data-archive-pagination
      hidden
    >
      <button
        class="rounded-lg border border-hairline bg-sand px-3 py-2 text-ink transition-colors hover:border-terracotta hover:text-terracotta disabled:cursor-not-allowed disabled:opacity-50"
        data-archive-previous
        type="button"
      >
        ← Previous
      </button>
      <span class="text-muted" data-archive-page-label></span>
      <button
        class="rounded-lg border border-hairline bg-sand px-3 py-2 text-ink transition-colors hover:border-terracotta hover:text-terracotta disabled:cursor-not-allowed disabled:opacity-50"
        data-archive-next
        type="button"
      >
        Next →
      </button>
    </nav>
    <Pagination basePath={basePath} page={page} pageCount={pageCount} />
  </div>
</div>

<script>
  import { initializeWorkArchive } from "../lib/workArchive";

  document
    .querySelectorAll<HTMLElement>("[data-work-archive]")
    .forEach((archive) => {
      void initializeWorkArchive(archive);
    });
</script>
