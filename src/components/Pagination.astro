---
interface Props {
  basePath: string;
  page: number;
  pageCount: number;
}

const { basePath, page, pageCount } = Astro.props;
const pageUrl = (pageNumber: number) =>
  pageNumber === 1 ? `${basePath}/` : `${basePath}/page/${pageNumber}/`;
---

{pageCount > 1 && (
  <nav aria-label="Pagination" class="flex items-center justify-between border-t border-hairline pt-5 font-mono text-xs">
    {page > 1 ? (
      <a class="rounded-lg border border-hairline bg-sand px-3 py-2 text-ink transition-colors hover:border-terracotta hover:text-terracotta" href={pageUrl(page - 1)}>
        ← Newer posts
      </a>
    ) : (
      <span></span>
    )}
    <span aria-current="page" class="text-muted">
      Page {page} of {pageCount}
    </span>
    {page < pageCount ? (
      <a class="rounded-lg border border-hairline bg-sand px-3 py-2 text-ink transition-colors hover:border-terracotta hover:text-terracotta" href={pageUrl(page + 1)}>
        Older posts →
      </a>
    ) : (
      <span></span>
    )}
  </nav>
)}
