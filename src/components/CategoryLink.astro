---
import type { BlogCategory } from '../schemas/blog';

interface Props {
  category: BlogCategory;
  type: string;
}

const { category, type } = Astro.props;
const categoryLabel = category.label;
---

<a
  aria-label={`View all ${categoryLabel} posts`}
  class="rounded border border-hairline bg-sand px-2 py-0.5 font-bold text-terracotta transition-colors hover:border-terracotta hover:underline focus-visible:underline"
  data-pagefind-filter={`category:${category.id}`}
  href={`/work/category/${category.id}/`}
>
  {type}
</a>
