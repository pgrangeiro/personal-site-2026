---
import WorkArchive from '../../components/WorkArchive.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBlogPosts, toBlogSummary } from '../../lib/blog';
import { getPageCount, getPageItems } from '../../lib/pagination';

const posts = await getBlogPosts();
const pageCount = getPageCount(posts.length);
const postSummaries = getPageItems(posts, 1).map(toBlogSummary);
---

<BaseLayout
  title="Work & Notes"
  description="A consolidated index of engineering leadership playbooks, AI prototypes, and architecture notes."
  enableSearch
>
  <WorkArchive posts={postSummaries} page={1} pageCount={pageCount} />
</BaseLayout>
