---
import { getBlogCategories, getBlogPosts, toBlogSummary } from '../../../lib/blog';
import { getPaginatedPages } from '../../../lib/pagination';
import WorkArchive from '../../../components/WorkArchive.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  const categories = getBlogCategories(posts);

  return getPaginatedPages(posts).slice(1).map(({ page, pageCount, items }) => {
    return {
      params: { page: String(page) },
      props: {
        posts: items.map(toBlogSummary),
        categories,
        page,
        pageCount,
      },
    };
  });
}

const { posts, categories, page, pageCount } = Astro.props;
---

<BaseLayout
  title={`Work & Notes — Page ${page}`}
  description="Engineering leadership playbooks, AI prototypes, and architecture notes."
>
  <WorkArchive categories={categories} posts={posts} page={page} pageCount={pageCount} />
</BaseLayout>
