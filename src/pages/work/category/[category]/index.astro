---
import type { BlogCategory } from '../../../../schemas/blog';
import { getBlogCategories, getBlogPosts, toBlogSummary } from '../../../../lib/blog';
import { getPaginatedPages } from '../../../../lib/pagination';
import WorkArchive from '../../../../components/WorkArchive.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  const categories = getBlogCategories(posts);

  return categories.map((category) => {
    const categoryPosts = posts.filter((post) => post.data.category.id === category.id);
    const [firstPage] = getPaginatedPages(categoryPosts);
    return {
      params: { category: category.id },
      props: {
        posts: firstPage.items.map(toBlogSummary),
        pageCount: firstPage.pageCount,
        category,
        categories,
      },
    };
  });
}

const { posts, pageCount, category, categories } = Astro.props as {
  posts: ReturnType<typeof toBlogSummary>[];
  pageCount: number;
  category: BlogCategory;
  categories: BlogCategory[];
};
---

<BaseLayout title={category.label} description={`All posts in ${category.label}.`}>
  <WorkArchive categories={categories} posts={posts} page={1} pageCount={pageCount} category={category} />
</BaseLayout>
