---
import BaseLayout from '../layouts/BaseLayout.astro';
import { currentFocus } from '../data/currentFocus';

const updatedDate = new Date(`${currentFocus.updatedAt}T00:00:00Z`);
const updatedMonth = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(updatedDate);
---

<BaseLayout
  title="About"
  description="Paula Grangeiro's path from senior software engineer to hands-on engineering manager."
>
  <div class="space-y-10">
    <header class="space-y-3 border-b border-hairline pb-6">
      <span class="font-mono text-xs font-semibold uppercase tracking-wider text-terracotta">
        BIOGRAPHY & PHILOSOPHY
      </span>
      <h1 class="max-w-3xl font-editorial text-3xl font-bold text-ink sm:text-4xl">
        From Senior Software Engineer to Hands-On Engineering Manager
      </h1>
    </header>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <div class="space-y-6 text-base leading-relaxed text-ink md:col-span-2">
        <p>
          Over the last decade, I've journeyed from building distributed systems and backend software as a Senior IC to guiding engineering teams as an Engineering Manager.
        </p>
        <p>
          I believe the most effective engineering managers in the AI era maintain deep technical empathy. When coding agents accelerate implementation, engineering leadership isn't about managing backlog status—it's about mentoring engineers, setting architectural standards, and fostering team psychological safety.
        </p>

        <section aria-labelledby="current-focus" class="space-y-4 rounded-2xl border border-[#333] bg-ink p-6 text-paper shadow-md">
          <div class="flex items-center justify-between gap-3 border-b border-[#333] pb-3">
            <h2 class="font-mono text-xs font-bold uppercase tracking-wider text-terracotta-on-dark" id="current-focus">
              Current Focus
            </h2>
            <time class="font-mono text-[10px] text-muted-light" datetime={currentFocus.updatedAt}>
              Updated {updatedMonth}
            </time>
          </div>
          <div class="grid gap-4 font-mono text-xs text-sand sm:grid-cols-2 sm:text-sm">
            <div class="space-y-1">
              <h3 class="font-bold text-terracotta-on-dark">Building with AI</h3>
              <p class="leading-relaxed text-muted-light">{currentFocus.buildingWithAI}</p>
            </div>
            <div class="space-y-1">
              <h3 class="font-bold text-terracotta-on-dark">Leading &amp; Mentoring</h3>
              <p class="leading-relaxed text-muted-light">{currentFocus.leadingAndMentoring}</p>
            </div>
            <div class="space-y-1">
              <h3 class="font-bold text-terracotta-on-dark">Reading</h3>
              <ul class="space-y-1 text-muted-light">
                {currentFocus.reading.map(({ title, note }) => (
                  <li>
                    <em>{title}</em>{note && <> — {note}</>}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>

        <h2 class="pt-2 font-editorial text-xl font-bold text-ink">Core Beliefs I Lead By</h2>
        <div class="space-y-3">
          <section class="rounded-xl border border-hairline bg-sand p-4">
            <h3 class="font-mono text-sm font-bold text-terracotta">1. Lead From the Front</h3>
            <p class="mt-1 text-sm text-muted">
              Never assign a workflow or linter tool to your team that you haven't personally benchmarked and tested yourself.
            </p>
          </section>
          <section class="rounded-xl border border-hairline bg-sand p-4">
            <h3 class="font-mono text-sm font-bold text-terracotta">2. AI Multiplies Leverage, Not Quality</h3>
            <p class="mt-1 text-sm text-muted">
              AI generates boilerplate in seconds. Leaders must teach teams how to write evals and maintain crisp architectural boundaries.
            </p>
          </section>
        </div>
      </div>

      <aside class="h-fit space-y-4 rounded-2xl border border-hairline bg-sand p-6">
        <h2 class="font-mono text-xs font-bold uppercase tracking-wider text-terracotta">
          Connect & Socials
        </h2>
        <nav aria-label="Social profiles" class="space-y-3 font-mono text-sm">
          <a class="block text-ink hover:text-terracotta" href="https://github.com/pgrangeiro" rel="noreferrer" target="_blank">
            GitHub (@pgrangeiro)
          </a>
          <a class="block text-ink hover:text-terracotta" href="https://www.linkedin.com/in/paulagrangeiro/" rel="noreferrer" target="_blank">
            LinkedIn (/in/paulagrangeiro)
          </a>
          <a class="block text-ink hover:text-terracotta" href="https://twitter.com/paulagrangeiro" rel="noreferrer" target="_blank">
            X (@paulagrangeiro)
          </a>
        </nav>
      </aside>
    </div>

  </div>
</BaseLayout>
